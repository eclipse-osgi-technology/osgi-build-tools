# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs
# editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_size = 4
indent_style = space
trim_trailing_whitespace = true

[*.{xml,json,yml,yaml}]
indent_size = 2

[{LICENSE,*.md,*.g4}]
indent_size = unset

[*.bndrun]
indent_style = tab
insert_final_newline = false
trim_trailing_whitespace = false

[license.templates]
indent_size = unset
trim_trailing_whitespace = unset

[Makefile]
indent_style = tab

[**/*.{ecore,genmodel}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# Taken over as they are: the profiling stylesheets of docbook-xsl, and the
# stylesheets, tools and test chapter of the OSGi specification build
[maven-plugins/osgi-docbook-maven-plugin/src/main/resources/docbook/docbook-xsl/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

[maven-plugins/osgi-docbook-maven-plugin/src/main/resources/docbook/{book/book-setup.xsl,xsl/*.xsl}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

[maven-plugins/osgi-docbook-maven-plugin/src/main/java/org/osgi/tools/{fop,xmldoclet}/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

[maven-plugins/osgi-docbook-maven-plugin/src/test/resources/test-projects/simple/src/main/resources/spec/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
